//@version=6
// 与 strategy/turtule_trade.py 和 strategy/turtle_size.py 对齐。
// 日线收盘生成信号，市价单在下一根 K 线开盘成交，只做多。
strategy(title = "Turtle aligned with Backtrader", overlay = true, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 4, commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 0, process_orders_on_close = false, margin_long = 100)

entryLen = input.int(20, "入场周期", minval = 1, group = "通道")
exitLen = input.int(10, "出场周期", minval = 1, group = "通道")
atrLen = input.int(20, "ATR 周期", minval = 1, group = "风险")
riskPct = input.float(1.0, "每单位风险（权益百分比）", minval = 0.01, step = 0.1, group = "风险")
cashBufPct = input.float(0.1, "现金缓冲（百分比）", minval = 0, step = 0.01, group = "风险")
maxUnits = input.int(4, "最多持仓单位", minval = 1, maxval = 4, group = "风险")
addStep = input.float(0.5, "加仓间隔（ATR）", minval = 0.1, step = 0.1, group = "风险")
stopMult = input.float(2.0, "止损距离（ATR）", minval = 0.1, step = 0.1, group = "风险")

// 通道不包含当前 K 线，对应 Backtrader 的 get(size=N, ago=-1)。
entryUp = ta.highest(high, entryLen)[1]
exitDown = ta.lowest(low, exitLen)[1]
atr = ta.atr(atrLen)

var int entryCount = 0
var float lastEntryPrice = na

// 根据持仓均价变化反推出最近新增单位的实际成交价。
positionAdded = strategy.position_size > nz(strategy.position_size[1])
if positionAdded
    oldSize = math.max(nz(strategy.position_size[1]), 0.0)
    addedSize = strategy.position_size - oldSize
    oldAvg = nz(strategy.position_avg_price[1])
    lastEntryPrice := addedSize > 0 ? (strategy.position_avg_price * strategy.position_size - oldAvg * oldSize) / addedSize : strategy.position_avg_price
    entryCount += 1

if strategy.position_size == 0
    entryCount := 0
    lastEntryPrice := na

// Pine 无法直接取得 Backtrader 的 broker cash。
// 对无杠杆现货多头，以权益减持仓市值近似可用现金。
estimatedCash = math.max(strategy.equity - math.max(strategy.position_size, 0.0) * close, 0.0)
riskSize = atr > 0 ? strategy.equity * riskPct / 100.0 / atr : 0.0
unitCost = close * 1.001
maxByCash = unitCost > 0 ? estimatedCash * (1.0 - cashBufPct / 100.0) / unitCost : 0.0
qtyRaw = math.min(riskSize, maxByCash)
qty = math.round(qtyRaw * 1e8) / 1e8
validQty = not na(qty) and qty > 0

warmup = bar_index < math.max(entryLen, atrLen)

if not warmup
    if strategy.position_size == 0
        if validQty and close > entryUp
            strategy.entry("L", strategy.long, qty = qty)
    else
        addOn = not na(lastEntryPrice) and close >= lastEntryPrice + addStep * atr and entryCount < maxUnits
        stopLoss = not na(lastEntryPrice) and close < lastEntryPrice - stopMult * atr

        // 平仓不能依赖 validQty，否则现金耗尽时会错过退出信号。
        if stopLoss or close < exitDown
            strategy.close("L")
        else if addOn and validQty
            strategy.entry("L", strategy.long, qty = qty)

plot(entryUp, title = "入场上轨", color = color.green)
plot(exitDown, title = "出场下轨", color = color.red)
plot(strategy.position_size > 0 and not na(lastEntryPrice) ? lastEntryPrice - stopMult * atr : na, title = "止损线", color = color.orange, style = plot.style_linebr)
plot(strategy.position_size > 0 ? strategy.position_avg_price : na, title = "持仓均价", color = color.blue, linewidth = 2, style = plot.style_linebr)
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)

plot(entryCount, title = "持仓单位数", display = display.data_window)
plot(lastEntryPrice, title = "最后成交价", display = display.data_window)
plot(qty, title = "下一单位数量", display = display.data_window)
